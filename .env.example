# Optional browser-side API base URL; defaults to http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated browser origins allowed by the API; local development defaults are below
MISSIONCUT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Neon PostgreSQL URL; keep the real value only in local .env or deployment secrets
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Long random secret used to sign MissionCut session tokens
MISSIONCUT_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
